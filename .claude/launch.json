{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "engine",
      "runtimeExecutable": "engine/.venv/bin/uvicorn",
      "runtimeArgs": [
        "app.api:app",
        "--app-dir",
        "engine",
        "--port",
        "8000"
      ],
      "port": 8000,
      "url": "http://localhost:8000"
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "3200"
      ],
      "port": 3200,
      "url": "http://localhost:3200"
    },
    {
      "name": "landing",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "landing",
        "run",
        "dev",
        "--",
        "--port",
        "3100"
      ],
      "port": 3100,
      "url": "http://localhost:3100"
    },
    {
      "name": "landing-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "landing",
        "run",
        "start",
        "--",
        "--port",
        "3101"
      ],
      "port": 3101,
      "url": "http://localhost:3101"
    }
  ]
}
