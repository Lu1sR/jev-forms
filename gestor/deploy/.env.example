# Gestor instance settings. Copy to .env next to docker-compose.yml.
# On EC2 this file is generated from SSM Parameter Store; never commit a filled copy.

# Where all state lives (Postgres, Redis, documents, exports). On EC2: /data (EBS volume).
DATA_ROOT=./data
# Image: leave unset locally (built from ../); on EC2 the ECR URI.
# GESTOR_IMAGE=
GESTOR_LOCAL_PORT=8000

# Public address. Local test: http://localhost:8000
PAPERLESS_URL=https://docs.luis-dev.com
GESTOR_DOMAIN=docs.luis-dev.com
GESTOR_APP_TITLE=Gestor

# Secrets: generate with ./gen-secrets.sh
POSTGRES_PASSWORD=
PAPERLESS_SECRET_KEY=
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=
PAPERLESS_ADMIN_MAIL=

# Language (OCR uses tesseract codes; dates and search use ISO codes)
GESTOR_OCR_LANGUAGE=spa+eng
GESTOR_DATE_ORDER=DMY
GESTOR_DATE_PARSER_LANGUAGES=es+en
GESTOR_SEARCH_LANGUAGE=es
GESTOR_TIME_ZONE=America/Guayaquil

# Workers (raise with a bigger VM)
GESTOR_TASK_WORKERS=1
GESTOR_THREADS_PER_WORKER=1
GESTOR_WEBSERVER_WORKERS=1
TIKA_MEM_LIMIT=700m
GOTENBERG_MEM_LIMIT=700m

# SMTP (Resend): user is literally "resend", password is a send-only API key.
# Leave SMTP_HOST empty to disable outgoing mail.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM="Gestor <gestor@luis-dev.com>"

# Ingress: tunnel profile
CLOUDFLARE_TUNNEL_TOKEN=

# Flows (profile "flows"): n8n next to paperless. See flows/README.md.
N8N_LOCAL_PORT=5678
N8N_MEM_LIMIT=700m
# Secrets: generate with ./gen-secrets.sh. Losing N8N_ENCRYPTION_KEY makes the stored
# credentials unreadable; keep it with the other secrets (SSM on EC2).
N8N_DB_PASSWORD=
N8N_ENCRYPTION_KEY=
# Formularios engine (public URL + the key issued to this client in ENGINE_API_KEYS)
FORMULARIOS_URL=https://formularios-api.docutecec.com
FORMULARIOS_API_KEY=
# Google Sheets target of the "sheets" flow: spreadsheet id (from its URL) and tab name.
# The sheet must be shared with the service account in flows/credentials (editor).
FLOWS_SHEETS_ID=
FLOWS_SHEETS_TAB=Facturas
# Paperless: token of the "flujos" service user (printed once by flows/paperless_setup.py)
# and the secret Paperless sends in the X-Flows-Secret header of each webhook.
PAPERLESS_FLOWS_TOKEN=
FLOWS_WEBHOOK_SECRET=

# Backups: s3://bucket/prefix (empty = keep local only, under DATA_ROOT/backups)
BACKUP_S3_URI=
BACKUP_LOCAL_DAYS=3
