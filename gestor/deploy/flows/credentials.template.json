[
  {
    "id": "paperlessApiTok1",
    "name": "Paperless API (flujos)",
    "type": "httpHeaderAuth",
    "data": { "name": "Authorization", "value": "Token ${PAPERLESS_FLOWS_TOKEN}" }
  },
  {
    "id": "flowsWebhookSec1",
    "name": "Webhook secret (Paperless → n8n)",
    "type": "httpHeaderAuth",
    "data": { "name": "X-Flows-Secret", "value": "${FLOWS_WEBHOOK_SECRET}" }
  },
  {
    "id": "formulariosKey01",
    "name": "Formularios API",
    "type": "httpHeaderAuth",
    "data": { "name": "X-API-Key", "value": "${FORMULARIOS_API_KEY}" }
  },
  {
    "id": "googleSvcAcct001",
    "name": "Google (cuenta de servicio)",
    "type": "googleApi",
    "data": { "email": "${GOOGLE_SA_EMAIL}", "privateKey": "${GOOGLE_SA_PRIVATE_KEY}", "inpersonate": false }
  }
]
