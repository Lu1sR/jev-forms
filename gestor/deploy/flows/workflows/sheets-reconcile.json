      "parameters": {
        "jsCode": "// Un ítem por flujo configurado en FLOWS_SHEETS_TARGETS (siempre al menos \"sheets\").\nlet targets = {};\ntry { targets = JSON.parse($env.FLOWS_SHEETS_TARGETS || '{}'); } catch (e) {}\nconst flows = Object.keys(targets).length ? Object.keys(targets) : ['sheets'];\nreturn flows.map(flow => ({ json: { flow, entry_tag: `flujo:${flow}`,\n  exclude_tags: [`flujo:${flow}:ok`, `flujo:${flow}:revisar`, `flujo:${flow}:error`],\n  stale_tag: `flujo:${flow}:procesando`, stale_minutes: 30 } }));\n"
      },
