# Matcher: "jev" (OpenRouter) or "heuristic" (offline keyword baseline, no API)
MATCHER=jev
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13
# Traffic light thresholds
GREEN_THRESHOLD=0.85
# OCR engine: rapid (default, fast) or paddle (slower, fixes sideways photos)
OCR_ENGINE=rapid

# API keys, one per client (name:key, comma separated). Empty = open API (local dev only).
# Generate a key with: openssl rand -hex 24
ENGINE_API_KEYS=
